# Environment variables for Cloud Deployment (Azure/IBM Cloud)
# Copy this file to .env and update the values

# Database Configuration
DB_PASSWORD=your_secure_database_password_here

# VPN Configuration
VPN_SERVER_IP=10.10.10.1
VPN_ADMIN_PASSWORD=your_vpn_admin_password_here
# IMPORTANT: Set your server's public IP or domain name for VPN clients to connect
VPN_PUBLIC_IP=your_server_public_ip_or_domain

# API URL (for production use with domain/SSL)
API_URL=https://your-domain.com

# OpenVPN Network Settings
OVPN_NETWORK=10.8.0.0/24
OVPN_SUBNET=10.10.10.0/24
OVPN_SERVER=10.10.10.1

# Application Settings
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Optional: SSL Certificates (mount external volume)
# SSL_CERT_PATH=/path/to/ssl/certs
# SSL_KEY_PATH=/path/to/ssl/keys
